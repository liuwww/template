<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>io.github.liuwww</groupId>
	<version>2.0.0</version>
	<artifactId>template-jdbc</artifactId>
	<packaging>pom</packaging>
	<name>template-jdbc</name>
	<description>template-jdbc,based on spring JdbcTemplate</description>
	<url>https://github.com/liuwww/template</url>

	<modules>
		<module>template-jdbc-core</module>
		<module>template-jdbc-spring</module>
	</modules>

	<!-- 保留 licenses, scm, developers 部分 -->
	<licenses>
		<license>
			<name>The Apache Software License, Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<scm>
		<connection>scm:git:git@github.com:liuwww/template.git</connection>
		<url>https://github.com/liuwww/template</url>
	</scm>
	<developers>
		<developer>
			<id>lww</id>
			<name>lww</name>
			<email>liuweiwei6880@163.com</email>
		</developer>
	</developers>

	<!-- 属性部分移到这里，供子模块使用 -->
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<springframework.version>4.2.9.RELEASE</springframework.version>
		<mysql.version>8.0.28</mysql.version>
		<oracle.version>10.2.0.2</oracle.version>
		<fastjson.version>1.2.83</fastjson.version>
		<common.beanutils.version>1.11.0</common.beanutils.version>
		<commons-configuration.verion>1.9</commons-configuration.verion>
		<commons-io.version>2.14.0</commons-io.version>
		<commons-lang.version>2.6</commons-lang.version>
		<alibaba.druid>1.2.15</alibaba.druid>
		<slf4j.version>2.0.0-alpha2</slf4j.version>
		<log4j.servion>2.17.1</log4j.servion>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
	</properties>

	<!-- 构建配置保留在父POM中 -->
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.2.1</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>verify</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.3.1</version>
				<configuration>
					<aggregate>true</aggregate>
					<charset>UTF-8</charset>
					<encoding>UTF-8</encoding>
					<docencoding>UTF-8</docencoding>
					<doclint>none</doclint>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-gpg-plugin</artifactId>
				<executions>
					<execution>
						<id>sign-artifacts</id>
						<phase>verify</phase>
						<goals>
							<goal>sign</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<source>${maven.compiler.source}</source>
					<target>${maven.compiler.target}</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.sonatype.central</groupId>
				<artifactId>central-publishing-maven-plugin</artifactId>
				<version>0.8.0</version>
				<extensions>true</extensions>
				<configuration>
					<publishingServerId>central</publishingServerId>
					<autoPublish>false</autoPublish>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>